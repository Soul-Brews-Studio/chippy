#!/bin/zsh
# eg1 <check|convert|parity|export> [--model ID] [args] — convert_gemma1.py (EmbeddingGemma v1) with its pinned dependencies.
# Library warning noise (untested torch version, deprecations, progress bars) is dropped from stderr.
script=convert_gemma1.py
export HF_HUB_DISABLE_PROGRESS_BARS=1 TRANSFORMERS_VERBOSITY=error PYTHONWARNINGS=ignore
uv run -q --prerelease allow --with 'sentence-transformers[image]>=6.1' --with 'transformers>=5.18.0.dev0' \
  --with pillow --with coremltools==9.0 --with tokenizers python "${0:A:h}/$script" "$@" \
  2> >(rg -v -i 'torch version|has not been tested|deprecated|n_bits|Loading weights|scikit-learn version|Converting PyTorch|Running MIL|^\s*$' >&2)
